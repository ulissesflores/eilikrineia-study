# Frozen trial image for study 3 (E18). The pin is the built image's digest, recorded in the preregistration;
# this file documents how it was made. Base images are pinned by digest (pulled 2026-11-08).
# node 22.23.4 (claude-code 2.1.319 requires node >= 22); Python 3.11.18 for the hidden checks (study 2 interpreter);
# openssh-client because the `claim` tool signs ledger entries with ssh-keygen -Y (arms S and P).
FROM docker.io/library/node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS node
FROM docker.io/library/python:3.11.18-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && apt-get update && apt-get install -y --no-install-recommends git ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code@2.1.319 && npm cache clean --force
# Claude Code refuses to bypass permissions as root, and the agent should not be root anyway.
RUN useradd -m -u 1000 agent
USER agent
WORKDIR /home/agent
ENV DISABLE_AUTOUPDATER=1
